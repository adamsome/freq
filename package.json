{
  "name": "freq",
  "author": "@adamsome",
  "version": "0.9.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamsome/freq"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --inspect=9230 -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "type-check": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run type-check"
    }
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^1.9.3",
    "@reduxjs/toolkit": "^1.9.7",
    "date-fns": "^2.30.0",
    "immer": "^9.0.21",
    "mongodb": "^4.17.2",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-responsive-modal": "^8.0.0",
    "react-spring-bottom-sheet": "^3.4.1",
    "resize-observer-polyfill": "^1.5.1",
    "swr": "^2.5.1",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "autoprefixer": "^10.6.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "postcss": "^8.5.32",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "@types/react-dom": "^19"
  },
  "overrides": {
    "react-spring-bottom-sheet": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@reach/portal": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@xstate/react": {
      "react": "$react"
    },
    "@reduxjs/toolkit": {
      "react": "$react"
    }
  }
}
